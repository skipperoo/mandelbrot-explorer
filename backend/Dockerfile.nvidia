# backend/Dockerfile

# --- Build Stage ---
FROM gcc:12 AS builder

WORKDIR /app

# Install development headers for OpenGL and EGL
RUN apt-get update && apt-get install -y \
    libgl-dev \
    libegl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy source code
COPY . .

# Build the project
# We ensure architecture flags are set for AVX2. 
# NOTE: The host machine MUST support AVX2 for this to run.
RUN make clean && make -j

# --- Runtime Stage ---
FROM nvidia/opengl:1.0-glvnd-runtime-ubuntu22.04
# FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies for OpenGL/EGL
RUN apt-get update && apt-get install -y \
    libegl1 \
    libgl1 \
    libglapi-mesa \
    libgbm1 \
    mesa-utils \
    && rm -rf /var/lib/apt/lists/*

# Copy the binary from the builder stage
# Adjust the path "bin/server" if your Makefile outputs somewhere else
COPY --from=builder /app/bin/server /app/server

# Copy the frontend to the www directory to be served by the backend
COPY frontend/ /var/www/

# Ensure execution permissions
RUN chmod +x /app/server

# Expose the backend port
EXPOSE 8080

# Run the server with Thread Count arguments (optional)
# We use shell form to allow passing args via docker-compose if needed
CMD ["./server"]
